<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <link rel="icon" href="../app.ico">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <style>
      .hide-cursor {
        cursor: none !important;
      }
      .splash-screen {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        background-color: #ff4c4c;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }
      .splash-screen[hidden],
      .tw-loaded .splash-screen {
        display: none;
      }
      .splash-spinner:after {
        content: " ";
        display: block;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 6px solid;
        border-color: #ff4c4c transparent #ff4c4c transparent;
        animation: splash-spinner 1.2s linear infinite;
      }
      @keyframes splash-spinner {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>
    <script src="static/sherpa-onnx/sherpa-onnx-asr.js"></script>
    <script src="static/sherpa-onnx/sherpa-onnx-vad.js"></script>
    <script src="static/sherpa-onnx/app.js"></script>
    <script src="static/sherpa-onnx/sherpa-onnx-wasm-main-vad-asr.js"></script>
    <script src="static/node_modules/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
    <script src="static/node_modules/@mediapipe/face_detection/face_detection.js" crossorigin="anonymous"></script>
    <script src="static/node_modules/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
    <script src="static/node_modules/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
    <script src="static/node_modules/@mediapipe/pose/pose.js" crossorigin="anonymous"></script>
    <script src="static/node_modules/@mediapipe/holistic/holistic.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <noscript>
      <div class="splash-screen">
        <h1>This embed requires JavaScript</h1>
      </div>
    </noscript>

    <div class="splash-screen" hidden id="splash-need-js">
      <div class="splash-spinner"></div>
    </div>

    <script>
      (function() {
        'use strict';

        var splash = document.getElementById('splash-need-js');
        splash.hidden = false;

        window.SplashEnd = () => {
          splash.hidden = true;
        };
      }());
    </script>

    <div id="app"></div>
  </body>
</html>
